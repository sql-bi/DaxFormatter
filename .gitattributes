# Git detects text files from their content and stores them with LF line endings, whatever the committer's settings.
* text=auto

# Images are binary: no line-ending conversion and no text diff.
*.png binary

# Strong-name keys are binary wherever one appears; the root .gitignore keeps them out of commits.
*.snk binary

# The npm lock file is written by npm: GitHub collapses it in diffs and leaves it out of the language statistics.
package-lock.json linguist-generated
