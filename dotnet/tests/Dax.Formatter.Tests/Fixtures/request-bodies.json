{
  "description": "Calls of a client with the JSON body of the request that it sends. The application is the name and the version that the client was given. Blank texts are not sent. Line breaks appear only as escapes.",
  "cases": [
    {
      "name": "default options",
      "application": { "name": "Test App", "version": "1.2.3" },
      "options": {},
      "texts": [ "EVALUATE Sales", "EVALUATE Customer" ],
      "body": {
        "dax": [ "EVALUATE Sales", "EVALUATE Customer" ],
        "maxLineLength": 0,
        "skipSpaceAfterFunctionName": false,
        "listSeparator": ",",
        "decimalSeparator": ".",
        "callerApp": "Test App",
        "callerVersion": "1.2.3"
      }
    },
    {
      "name": "short lines",
      "application": { "name": "Test App", "version": "1.2.3" },
      "options": { "lineStyle": "shortLine" },
      "texts": [ "EVALUATE Sales" ],
      "body": {
        "dax": [ "EVALUATE Sales" ],
        "maxLineLength": 1,
        "skipSpaceAfterFunctionName": false,
        "listSeparator": ",",
        "decimalSeparator": ".",
        "callerApp": "Test App",
        "callerVersion": "1.2.3"
      }
    },
    {
      "name": "no space after function names",
      "application": { "name": "Test App", "version": "1.2.3" },
      "options": { "spacingStyle": "noSpaceAfterFunction" },
      "texts": [ "EVALUATE Sales" ],
      "body": {
        "dax": [ "EVALUATE Sales" ],
        "maxLineLength": 0,
        "skipSpaceAfterFunctionName": true,
        "listSeparator": ",",
        "decimalSeparator": ".",
        "callerApp": "Test App",
        "callerVersion": "1.2.3"
      }
    },
    {
      "name": "semicolon and comma as separators",
      "application": { "name": "Test App", "version": "1.2.3" },
      "options": { "separatorStyle": "semicolonAndComma" },
      "texts": [ "EVALUATE ROW(\"a\"; 1,5)" ],
      "body": {
        "dax": [ "EVALUATE ROW(\"a\"; 1,5)" ],
        "maxLineLength": 0,
        "skipSpaceAfterFunctionName": false,
        "listSeparator": ";",
        "decimalSeparator": ",",
        "callerApp": "Test App",
        "callerVersion": "1.2.3"
      }
    },
    {
      "name": "expressions under their headers",
      "application": { "name": "Test App", "version": "1.2.3" },
      "options": { "kind": "expression" },
      "texts": [ "SUM(Sales[Amount])", "(a, b) => a + b", "// c\r\n(a) => a", "(1 + 2) * 3" ],
      "body": {
        "dax": [
          "[x] :=\nSUM(Sales[Amount])",
          "FUNCTION x =\n(a, b) => a + b",
          "FUNCTION x =\n// c\r\n(a) => a",
          "[x] :=\n(1 + 2) * 3"
        ],
        "maxLineLength": 0,
        "skipSpaceAfterFunctionName": false,
        "listSeparator": ",",
        "decimalSeparator": ".",
        "callerApp": "Test App",
        "callerVersion": "1.2.3"
      }
    },
    {
      "name": "blank texts left out",
      "application": { "name": "Test App", "version": "1.2.3" },
      "options": { "kind": "expression" },
      "texts": [ "", "1 + 2", " \r\n\t" ],
      "body": {
        "dax": [ "[x] :=\n1 + 2" ],
        "maxLineLength": 0,
        "skipSpaceAfterFunctionName": false,
        "listSeparator": ",",
        "decimalSeparator": ".",
        "callerApp": "Test App",
        "callerVersion": "1.2.3"
      }
    },
    {
      "name": "text with characters outside ASCII",
      "application": { "name": "Test App", "version": "1.2.3" },
      "options": {},
      "texts": [ "EVALUATE ROW(\"città\", \"😀 <&>\")" ],
      "body": {
        "dax": [ "EVALUATE ROW(\"città\", \"😀 <&>\")" ],
        "maxLineLength": 0,
        "skipSpaceAfterFunctionName": false,
        "listSeparator": ",",
        "decimalSeparator": ".",
        "callerApp": "Test App",
        "callerVersion": "1.2.3"
      }
    },
