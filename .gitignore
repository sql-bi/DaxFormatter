# Editor and operating system files, keys and npm installs, anywhere in the repository. Build output is ignored
# by each toolchain folder's own .gitignore, such as dotnet/.gitignore and typescript/packages/<package>/.gitignore.

# Strong-name keys and certificates: never committed, wherever one is copied
*.snk
*.pfx

# npm installs, also one run by mistake outside a package folder
node_modules/

# Visual Studio
.vs/

# JetBrains Rider
.idea/

# Visual Studio Code: nothing under it is tracked
.vscode/

# Vim swap files
*.swp

# macOS
.DS_Store

# Windows
Thumbs.db
